<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/imageloader_performance_stats"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/imageloader_summary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#E3F2FD"
            app:cardCornerRadius="6dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/txtDialogSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: 0 logs | Images: 0 | Errors: 0 | JSON: 0 photos"
                    android:textSize="12sp"
                    android:textColor="#424242" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💚 Memory Cache (Active + Memory)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="6dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/txtDialogMemory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Count: 0 images\nAvg Time: 0.0ms (instant)"
                    android:textSize="12sp"
                    android:textColor="#424242" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟠 Disk Cache"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardCornerRadius="6dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/txtDialogDisk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Count: 0 images\nAvg Time: 0.0ms | Decode: 0.0ms | Transform: 0.0ms"
                    android:textSize="12sp"
                    android:textColor="#424242" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 Network"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FCE4EC"
            app:cardCornerRadius="6dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/txtDialogNetwork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Count: 0 images\nAvg Time: 0.0ms | Fetch: 0.0ms | Decode: 0.0ms | Transform: 0.0ms"
                    android:textSize="12sp"
                    android:textColor="#424242" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
